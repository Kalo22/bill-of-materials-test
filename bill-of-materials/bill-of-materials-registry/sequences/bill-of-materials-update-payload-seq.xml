<?xml version="1.0" encoding="UTF-8"?>
<sequence name="bill-of-materials-update-payload-seq" trace="disable" xmlns="http://ws.apache.org/ns/synapse">
    <call-template target="gov:com/trumpf/esb/services/commons/esb-commons/v1/templates/logger-template-v1.xml">
        <with-param name="ProjectName" value="bill-of-materials"/>
        <with-param name="SequenceName" value="bill-of-materials-update-payload-seq"/>
        <with-param name="Message" value="Starting the bill-of-materials update request flow."/>
    </call-template>
    <validate cache-schema="true">
        <schema key="gov:com/trumpf/esb/services/bill-of-materials/v1/schemas/bill-of-materials-update-schema.json"/>
        <on-fail>
            <call-template target="gov:com/trumpf/esb/services/commons/esb-commons/v1/templates/error-template-v1.xml">
                <with-param name="ProjectName" value="bill-of-materials"/>
                <with-param name="SequenceName" value="bill-of-materials-update-payload-seq"/>
                <with-param name="CUSTOM_ERROR_MESSAGE" value="Invalid request payload, failed json schema validation"/>
                <with-param name="OUT_ERROR_MESSAGE" value="{concat('Incorrect input payload, ', $ctx:ERROR_MESSAGE)}"/>
                <with-param name="HTTP_CODE" value="400"/>
            </call-template>
            <respond/>
        </on-fail>
    </validate>
    <foreach id="foreach_items" expression="$body/jsonObject/items">
        <sequence>
            <filter xpath="boolean(//items/operation = 'U') or boolean(//items/operation = 'D') or boolean(//items/operation = 'INU')">
                <then>
                    <filter xpath="boolean(//items/itemGuid)">
                        <then/>
                        <else>
                            <property expression="//items/operation" name="operation"/>
                            <call-template target="gov:com/trumpf/esb/services/commons/esb-commons/v1/templates/error-template-v1.xml">
                                <with-param name="ProjectName" value="bill-of-materials"/>
                                <with-param name="SequenceName" value="bill-of-materials-update-payload-seq"/>
                                <with-param name="CUSTOM_ERROR_MESSAGE" value="{concat('Missing mandatory field - itemGuid for Operation : ', $ctx:operation)}"/>
                                <with-param name="OUT_ERROR_MESSAGE" value="{concat('Missing mandatory field - itemGuid for Operation : ', $ctx:operation)}"/>
                                <with-param name="HTTP_CODE" value="400"/>
                            </call-template>
                        </else>
                    </filter>
                </then>
                <else/>
            </filter>
        </sequence>
    </foreach>
    <xslt key="gov:com/trumpf/esb/services/bill-of-materials/xslt/bill-of-materials-update-payload-transformation.xsl">
        <property expression="$ctx:uri.var.materialNumber" name="materialNumber"/>
    </xslt>
    <call-template target="gov:com/trumpf/esb/services/commons/esb-commons/v1/templates/logger-template-v1.xml">
        <with-param name="ProjectName" value="bill-of-materials"/>
        <with-param name="SequenceName" value="bill-of-materials-update-payload-seq"/>
        <with-param name="Message" value="Ending the bill-of-materials update request flow."/>
    </call-template>
</sequence>
